{
  "name": "Browser SSH",
  "short_name": "SSH",
  "description": "SSH client running entirely in the browser via Direct Sockets",
  "version": "0.1.0",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "borderless",
    "window-controls-overlay"
  ],
  "background_color": "#16181d",
  "theme_color": "#1e2128",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "isolated_storage": true,
  "permissions_policy": {
    "cross-origin-isolated": [
      "self"
    ],
    "direct-sockets": [
      "self"
    ],
    "direct-sockets-private": [
      "self"
    ],
    "local-network-access": [
      "self"
    ],
    "local-network": [
      "self"
    ],
    "loopback-network": [
      "self"
    ],
    "window-management": [
      "self"
    ]
  }
}
